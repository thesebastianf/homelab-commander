# Homelab Commander � production compose example
# Copy to docker-compose.yml and configure .env before first run.
# Pull images from GitHub Container Registry (built by CI).

services:
  thc-app:
    image: ghcr.io/thesebastianf/homelab-commander:latest
    # Beta channel:
    # image: ghcr.io/thesebastianf/homelab-commander:beta
    ports:
      - "${APP_PORT:-3210}:3210"
    env_file:
      - .env
    environment:
      - APP_PORT=3210
      - NODE_ENV=${NODE_ENV:-production}
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - COMPOSE_RUNTIME_MODE=${COMPOSE_RUNTIME_MODE:-native}
      - STACKS_PATH=${STACKS_PATH:-/opt/homelab/stacks}
      - BACKUPS_PATH=${BACKUPS_PATH:-/opt/homelab/backups}
      - DATABASE_URL=postgresql://${POSTGRES_USER:-hlc}:${POSTGRES_PASSWORD:-hlc_secret_change_me}@thc-database:5432/${POSTGRES_DB:-hlc}
      - AUTH_USER=${AUTH_USER:-}
      - AUTH_PASS=${AUTH_PASS:-}
      - CORS_ORIGIN=${CORS_ORIGIN:-}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # CRITICAL: left path MUST equal right path.
      # The Docker daemon resolves these paths on the HOST — they must exist there.
      # Replace both sides with your actual absolute host paths.
      - /opt/homelab/stacks:/opt/homelab/stacks
      - /opt/homelab/backups:/opt/homelab/backups
      # GHCR / private registry auth — allows pulling private images during stack actions
      - /root/.docker/config.json:/root/.docker/config.json:ro
    depends_on:
      thc-database:
        condition: service_healthy
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3210/healthz"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  thc-database:
    image: postgres:16-alpine
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-hlc}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-hlc_secret_change_me}
      - POSTGRES_DB=${POSTGRES_DB:-hlc}
    volumes:
      - pg_data:/var/lib/postgresql/data
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    shm_size: "256mb"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-hlc}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

volumes:
  pg_data:
  # NOTE: No named volumes for app data. Use bind mounts with same:same paths above.
