# PostgreSQL
POSTGRES_USER=hlc
POSTGRES_PASSWORD=hlc_secret_change_me
POSTGRES_DB=hlc

# Backend
BACKEND_PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=3210

# Paths (inside backend container)
STACKS_PATH=/data/stacks
BACKUPS_PATH=/data/backups

# Optional basic auth (leave blank to disable)
AUTH_USER=
AUTH_PASS=

# CORS origin (for dev mode)
CORS_ORIGIN=http://localhost:5173
