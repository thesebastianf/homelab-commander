##############################################################################
# Homelab Commander — Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠  Never commit your real .env file — it contains secrets.
#    .env is already in .gitignore.
#
# SEED_ variables are OPTIONAL.
# They pre-populate the database on the very first startup (as long as you
# have not yet saved any settings through the UI).  After that first save the
# SEED_ variables are ignored on subsequent restarts — feel free to remove
# them from .env once you have configured everything through the UI.
##############################################################################


# ── Infrastructure ──────────────────────────────────────────────────────────

# Host port where the web UI is reachable.  Default: 3210
# Browse to http://your-server:3210 after first start.
FRONTEND_PORT=3210

# Host port for the backend API.  Rarely needs changing.
# Default: 3001
BACKEND_PORT=3001

# Node.js runtime mode.  Use "production" for deployments.
# Values: production | development
NODE_ENV=production

# Backend log verbosity.
# Values: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL credentials.  Change POSTGRES_PASSWORD before the first run!

POSTGRES_USER=hlc
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hlc


# ── Authentication ────────────────────────────────────────────────────────────
# Optional HTTP Basic Auth protecting the entire UI and API.
# Leave both empty to disable (suitable for a trusted LAN / VPN).
# Example:
#   AUTH_USER=admin
#   AUTH_PASS=mysecretpassword

AUTH_USER=
AUTH_PASS=


# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed CORS origin for the API.  Leave empty to allow all origins.
# Typical dev value: http://localhost:5173
# Typical prod value: https://hlc.yourdomain.com

CORS_ORIGIN=


##############################################################################
# SEED — Paths
#
# Override the default base paths that THC uses inside the container.
# These are written to the settings table on first startup.
# They can also be changed later via Settings → Paths.
#
# Inside the container the Docker-managed volumes are mounted at:
#   stacks_data  → /data/stacks
#   backups_data → /data/backups
#
# If you bind-mount an NFS share or a host directory, set the paths here so
# the UI displays the correct location and scripts use the right paths.
##############################################################################

# Where compose files for managed stacks are stored (inside the container).
# Default: /data/stacks
SEED_STACKS_BASE_PATH=/data/stacks

# Where named Docker volume data lives (for reference / backup purposes).
# Example: /mnt/nas/docker-volumes  or  /var/lib/docker/volumes
# Default: /data/volumes
SEED_VOLUMES_BASE_PATH=/data/volumes

# Where backup archives are written (inside the container).
# Default: /data/backups
SEED_BACKUPS_BASE_PATH=/data/backups


##############################################################################
# SEED — Home Assistant Integration
#
# Pushes container / stack status as sensors into Home Assistant.
# Configure via Settings → Home Assistant after first startup.
#
# SEED_HA_ENABLED      Set to "true" to activate on first boot.
# SEED_HA_BASE_URL     Your HA instance URL.
#                      Example: http://192.168.1.50:8123
# SEED_HA_ACCESS_TOKEN A Long-Lived Access Token from your HA profile page.
#                      HA UI → Profile → Long-Lived Access Tokens → Create.
# SEED_HA_ENTITY_PREFIX Prefix for sensor entity IDs.  Default: hlc
#                       Sensors will appear as sensor.hlc_<stack>_status etc.
##############################################################################

SEED_HA_ENABLED=false
SEED_HA_BASE_URL=
SEED_HA_ACCESS_TOKEN=
SEED_HA_ENTITY_PREFIX=hlc


##############################################################################
# SEED — Git Integration
#
# Keeps your stack compose files in sync with a Git repository.
# Configure via Settings → Git Integration after first startup.
#
# SEED_GIT_ENABLED      "true" to enable on first boot.
# SEED_GIT_REPO_URL     HTTPS clone URL of your repo.
#                       Example: https://github.com/you/homelab-stacks.git
#                       Also works with Gitea / Forgejo / GitLab self-hosted.
# SEED_GIT_ACCESS_TOKEN Personal Access Token (PAT) with repo read/write.
#                       GitHub:  Settings → Developer settings → PAT (classic)
#                       Gitea:   Settings → Applications → Access tokens
# SEED_GIT_SYNC_ON      When to push changes.
#                       Values: save | deploy | manual
##############################################################################

SEED_GIT_ENABLED=false
SEED_GIT_REPO_URL=
SEED_GIT_ACCESS_TOKEN=
SEED_GIT_SYNC_ON=manual


##############################################################################
# SEED — AI Settings
#
# Pre-configure Settings → AI on first startup.
# This is useful when you want AI compose generation/validation ready after
# first boot without manual setup in the UI.
#
# SEED_AI_ENABLED             Enable AI assistant features.
# SEED_AI_PROVIDER            ollama | openai | google | anthropic | custom
# SEED_AI_BASE_URL            Provider base URL.
#   - Ollama example: http://host.docker.internal:11434
#   - OpenAI example: https://api.openai.com/v1
#   - Google example: https://generativelanguage.googleapis.com/v1beta
#   - Anthropic example: https://api.anthropic.com/v1
# SEED_AI_API_KEY             API key (not needed for local Ollama).
# SEED_AI_MODEL               Model name, e.g. llama3.1, gpt-4.1, claude-3-7-sonnet-latest.
# SEED_AI_TREAT_AS_LOCAL      true only for trusted private endpoints.
# SEED_AI_ALLOW_ENV_TO_LOCAL  true allows raw .env values for local/private AI.
#                             For remote providers, backend still sends redacted
#                             compose content and env keys only.
##############################################################################

SEED_AI_ENABLED=false
SEED_AI_PROVIDER=ollama
SEED_AI_BASE_URL=http://host.docker.internal:11434
SEED_AI_API_KEY=
SEED_AI_MODEL=llama3.1
SEED_AI_TREAT_AS_LOCAL=true
SEED_AI_ALLOW_ENV_TO_LOCAL=false


##############################################################################
# SEED — Notification Services
#
# Pre-create notification service records on first startup.
# Services whose required credentials are empty will NOT be created.
# Add/edit services later via Settings → Notifications.
##############################################################################

# ── Telegram ─────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram.
# 2. Copy the token BotFather gives you into SEED_TELEGRAM_BOT_TOKEN.
# 3. Get your chat ID:
#    - Send any message to your bot
#    - Call: https://api.telegram.org/bot<TOKEN>/getUpdates
#    - The "id" field in "chat" is your SEED_TELEGRAM_CHAT_ID.
#    For a group/channel, the ID is negative (e.g. -1001234567890).

SEED_TELEGRAM_BOT_TOKEN=
SEED_TELEGRAM_CHAT_ID=

# ── Discord ──────────────────────────────────────────────────────────────────
# 1. Open your Discord server → Edit Channel → Integrations → Webhooks.
# 2. Create a new webhook and copy the URL.
# Example: https://discord.com/api/webhooks/123456789/ABCDEFG...

SEED_DISCORD_WEBHOOK_URL=

# ── Slack ─────────────────────────────────────────────────────────────────────
# 1. Go to https://api.slack.com/messaging/webhooks and create an app.
# 2. Enable Incoming Webhooks and copy the webhook URL.
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX

SEED_SLACK_WEBHOOK_URL=

# ── Generic Webhook ──────────────────────────────────────────────────────────
# Any HTTPS endpoint that accepts a POST with a JSON body.
# Works with ntfy.sh, n8n, Home Assistant webhooks, Zapier, etc.
# Example: https://ntfy.sh/my-homelab-topic
#          https://n8n.yourdomain.com/webhook/hlc

SEED_WEBHOOK_URL=
