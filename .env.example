# ── Infrastructure ──────────────────────────────────────────────────────────
APP_PORT=3210
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=hlc
POSTGRES_PASSWORD=hlc_secret_change_me
POSTGRES_DB=hlc

# ── Auth & CORS ──────────────────────────────────────────────────────────────
AUTH_USER=
AUTH_PASS=
CORS_ORIGIN=http://localhost:5173
# For production, change to: http://YOUR_SERVER_IP:3210

# ── Docker Compose Runtime (stack actions) ───────────────────────────────────
# auto = try native docker compose / docker-compose first, then sidecar images
COMPOSE_RUNTIME_MODE=auto
# Comma-separated fallback list (first image is preferred)
COMPOSE_SIDECAR_IMAGES=docker/compose:2.29.2,docker/compose:latest,docker/compose:v2.29.2

# ── SEED — Home Assistant (optional) ─────────────────────────────────────────
SEED_HA_ENABLED=false
SEED_HA_BASE_URL=
SEED_HA_ACCESS_TOKEN=
SEED_HA_ENTITY_PREFIX=hlc

# ── SEED — Git Integration (optional) ────────────────────────────────────────
SEED_GIT_ENABLED=false
SEED_GIT_REPO_URL=
SEED_GIT_ACCESS_TOKEN=
SEED_GIT_SYNC_ON=manual

# ── SEED — Notification Services (optional) ──────────────────────────────────
# Telegram: fill both token + chat ID to auto-create
SEED_TELEGRAM_BOT_TOKEN=
SEED_TELEGRAM_CHAT_ID=
# Discord webhook URL
SEED_DISCORD_WEBHOOK_URL=
# Slack webhook URL
SEED_SLACK_WEBHOOK_URL=
# Generic POST webhook URL
SEED_WEBHOOK_URL=
