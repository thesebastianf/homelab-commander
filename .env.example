##############################################################################
# HomeLab Commander V2 — Runtime Environment
#
# Copy this file to .env and fill in the values for your environment.
# Lines starting with # are comments and are ignored.
##############################################################################

# ── Core paths ────────────────────────────────────────────────────────────────

# Where HLC stores its database and runtime data (must be a persistent volume).
HLC_DATA_DIR=/data

# Absolute path on the HOST where your compose stacks live.
# HLC scans this directory for docker-compose.yml / compose.yaml files.
# Defaults to ./stacks (relative to docker-compose.yml) for easy local dev.
HLC_STACK_DIR_HOST=./stacks

# Where backups are written (can be a separate NAS share).
HLC_BACKUP_DIR=/data/backups

# ── Server ────────────────────────────────────────────────────────────────────

# Address HLC listens on inside the container.
HLC_LISTEN=:8080

# ── Docker ────────────────────────────────────────────────────────────────────

# Path to the Docker socket (mounted read-write into the container).
DOCKER_SOCKET=/var/run/docker.sock

# ── NAS / Mount safety ────────────────────────────────────────────────────────

# Filename that must exist at the root of a NAS mount to confirm it is online.
HLC_NAS_ANCHOR=.nas-ready

# ── Authentication ────────────────────────────────────────────────────────────

# Initial admin API token — change this before first run.
# Leave blank to disable token auth during development.
HLC_ADMIN_TOKEN=change-me-before-running

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/London
